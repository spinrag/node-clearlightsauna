# Frontend configuration — copy to frontend/.env and fill in.
# Vite loads this from the frontend/ directory; VITE_* vars are embedded into
# the client bundle at build time (do not put real secrets here).

# Backend location. LEAVE EMPTY for same-origin, which is what production should
# use: nginx routes /api/* and /socket.io/ on this app's own hostname to the
# backend, so the page and the API share one Cloudflare Access session.
# Set it only to reach a backend on a different origin — local dev against a
# separate port, or the standalone sauna-api hostname. Doing so creates a second
# Access session that expires independently of the page's, which is what used to
# strand the PWA on the login screen. See docs/CLOUDFLARE-ACCESS.md.
VITE_SOCKET_HOST=

VITE_API_TOKEN=change-me-to-a-random-secret   # Must match the backend API_TOKEN
VITE_DEV_MODE=true                       # Show the debug status JSON panel in the UI

# PORT is read by vite (dev/preview server), not VITE_-prefixed:
# PORT=8099
